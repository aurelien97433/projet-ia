# Préchargement du Jeu de démonstration (scripts/seed-demo.ts). Noms seulement, aucune valeur.
# Le fichier réel, .env.seed, est ignoré par git et n'est pas lu par Next.js.
# Pour le créer : powershell -NoProfile -File scripts\setup-seed-env.ps1 (docs/environnements.md).

# Projet visé. Hors de la machine locale, le script exige --remote.
SEED_SUPABASE_URL=

# Secrètes : jamais dans .env.local, Vercel, un fichier suivi ou une conversation.
SUPABASE_SERVICE_ROLE_KEY=
PROCESS_DOCUMENT_SECRET=

# Comptes de démonstration fictifs.
DEMO_ACCOUNT_A_EMAIL=
DEMO_ACCOUNT_A_PASSWORD=
DEMO_ACCOUNT_B_EMAIL=
DEMO_ACCOUNT_B_PASSWORD=

# Comptes de mesure (quota normal de 60 appels chacun).
MEASURE_ACCOUNT_1_EMAIL=
MEASURE_ACCOUNT_1_PASSWORD=
MEASURE_ACCOUNT_2_EMAIL=
MEASURE_ACCOUNT_2_PASSWORD=
MEASURE_ACCOUNT_3_EMAIL=
MEASURE_ACCOUNT_3_PASSWORD=
