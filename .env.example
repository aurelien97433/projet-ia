# Noms des variables, sans valeur. Copier vers .env.local (ignoré par git) et remplir localement.
# Aucune valeur ne doit être commitée ni collée dans une conversation.

# Publiques (navigateur) — à définir aussi dans Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secrète — Vercel, secrets Supabase et .env.local du script de préchargement.
PROCESS_DOCUMENT_SECRET=

# Secrète — secrets Supabase et .env.local du script de préchargement uniquement (jamais dans Vercel).
SUPABASE_SERVICE_ROLE_KEY=

# Comptes de démonstration et de mesure (préchargement, story 2.8) : DEMO_ACCOUNT_*, MEASURE_ACCOUNT_*.

# Uniquement dans les secrets Supabase (supabase secrets set), jamais dans un fichier .env de Next.js :
# OPENAI_API_KEY, AI_DAILY_QUOTA, RAG_MIN_SIMILARITY, GENERATION_MODEL.
# En local, les Edge Functions les lisent dans supabase/functions/.env (ignoré par git).
